# {{ ansible_managed }}
PORTAL_ENV=production
DATABASE_URL={{ portal_database_url }}
PUBLIC_ORIGIN={{ public_origin }}
OIDC_ISSUER={{ oidc_issuer }}
OIDC_CLIENT_ID=portal
OIDC_CLIENT_SECRET={{ portal_oidc_client_secret }}
{% if portal_ca_bundle_src | length > 0 %}
SSL_CERT_FILE=/etc/portal/ca.pem
{% endif %}
