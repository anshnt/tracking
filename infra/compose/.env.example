# Copy to .env (never commit .env). Every CHANGE_ME must be replaced with a long random value,
# e.g. `openssl rand -base64 32`. Versions live in ../versions.env.

# Hostnames resolve as portal.<LAB_DOMAIN>, auth.<LAB_DOMAIN>, desktop.<LAB_DOMAIN>, git.<LAB_DOMAIN>.
# Add them to the hosts file of the test laptop (or the lab DNS) pointing at the lab host.
LAB_DOMAIN=lab.test
EDGE_BIND_IP=127.0.0.1
# Source addresses allowed to reach the Keycloak admin console (management network).
MGMT_CIDR=127.0.0.1/32
WORKSPACE_SUBNET=10.77.50.0/24

# production refuses dev auth, placeholder secrets and http origins
PORTAL_ENV=production
PORTAL_IMAGE_TAG=lab

# Postgres: superuser is used only by the init script. Apps have their own roles.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
GUACAMOLE_DB_PASSWORD=CHANGE_ME
GITEA_DB_PASSWORD=CHANGE_ME
PORTAL_MIGRATOR_DB_PASSWORD=CHANGE_ME
PORTAL_DB_PASSWORD=CHANGE_ME
BACKUP_DB_PASSWORD=CHANGE_ME

# Keycloak
KEYCLOAK_BOOTSTRAP_ADMIN=bootstrap-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
PORTAL_CLIENT_SECRET=CHANGE_ME

# Guacamole: SAML NameID (email) of the first operator who becomes Guacamole admin
GUAC_BOOTSTRAP_ADMIN=CHANGE_ME@example.invalid
# Optional JVM options, e.g. -Djavax.net.ssl.trustStore=/etc/guac-truststore/cacerts (see infra/README.md)
GUAC_JAVA_OPTS=
